{
  "manifest_version": 3,
  "name": "Resume Factory",
  "version": "2.0",
  "description": "Send job descriptions to local backend for resume tailoring.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Factory"
  }
}